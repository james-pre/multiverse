{
	"name": "@james-pre/multiverse",
	"version": "0.0.0",
	"description": "View game saves as branching timelines",
	"type": "module",
	"author": "James Prevett <jp@jamespre.dev> (https://jamespre.dev)",
	"license": "LGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/james-pre/multiverse.git"
	},
	"homepage": "https://github.com/james-pre/multiverse",
	"bugs": {
		"url": "https://github.com/james-pre/multiverse/issues"
	},
	"engines": {
		"node": ">= 22"
	},
	"bin": {
		"multiverse": "dist/main.js"
	},
	"files": [
		"dist",
		"native/*.js",
		"native/*.node",
		"data",
		"locales",
		"LICENSE.md"
	],
	"exports": {
		".": "./dist/index.js",
		"./*": "./dist/*.js"
	},
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "locales-typegen && tsc -p tsconfig.json --noEmit && tsc -p src/gui/tsconfig.json --noEmit && eslint src",
		"build": "locales-typegen && tsc -p tsconfig.json && tsc -p src/gui/tsconfig.json",
		"test": "tsx --test tests/*.test.ts",
		"build:native": "girbind build",
		"postinstall": "node dist/main.js install --global-only",
		"prepublishOnly": "npm run build",
		"build:sea": "node scripts/sea.js",
		"build:icon": "node scripts/icon.js"
	},
	"prettier": {
		"singleQuote": true,
		"useTabs": true,
		"trailingComma": "es5",
		"tabWidth": 4,
		"printWidth": 120,
		"arrowParens": "avoid",
		"experimentalOperatorPosition": "start"
	},
	"girbindDependencies": [
		"gio",
		"graphene",
		"pango",
		"gdk",
		"gsk",
		"gtk",
		"adw"
	],
	"dependencies": {
		"@james-pre/locales": "^1.0.1",
		"commander": "^15.0.0",
		"girbind": "^0.6.0",
		"ioium": "^1.11.1",
		"memium": "^1.1.1",
		"utilium": "^3.10.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@commander-js/extra-typings": "^15.0.0",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.5",
		"eslint": "^10.13.0",
		"girbind-devel": "^0.6.0",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"xsea": "^1.0.1"
	}
}
