{
	"name": "save-timeline",
	"version": "0.0.0",
	"description": "View game saves as branching timelines",
	"type": "module",
	"private": true,
	"author": "James Prevett <jp@jamespre.dev> (https://jamespre.dev)",
	"license": "LGPL-3.0-or-later",
	"engines": {
		"node": ">= 22"
	},
	"bin": {
		"save-timeline": "dist/main.js"
	},
	"exports": {
		".": "./dist/index.js",
		"./*": "./dist/*.js"
	},
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "tsc -p tsconfig.json --noEmit && tsc -p src/gui/tsconfig.json --noEmit && eslint src",
		"build": "tsc -p tsconfig.json && tsc -p src/gui/tsconfig.json",
		"build:native": "girbind build",
		"test": "tsx --test tests/*.test.ts",
		"start": "node dist/main.js"
	},
	"prettier": {
		"singleQuote": true,
		"useTabs": true,
		"trailingComma": "es5",
		"tabWidth": 4,
		"printWidth": 120,
		"arrowParens": "avoid",
		"experimentalOperatorPosition": "start"
	},
	"girbindDependencies": [
		"gio",
		"graphene",
		"pango",
		"gdk",
		"gsk",
		"gtk",
		"adw"
	],
	"dependencies": {
		"commander": "^15.0.0",
		"girbind": "^0.3.1",
		"ioium": "^1.11.1",
		"utilium": "^3.10.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@commander-js/extra-typings": "^15.0.0",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.5",
		"eslint": "^10.13.0",
		"girbind-devel": "^0.3.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0"
	}
}
